{
  "name": "love-and-co",
  "version": "1.0.0",
  "description": "Love & Co. — Direct-to-Consumer Natural Skincare & Cold-Pressed Formulations with Multi-Agent AI Routine Copilot",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run start:server\" \"npm run start:client\"",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "start:client": "npm --prefix client start"
  },
  "keywords": [
    "cold-pressed-soap",
    "botanical-skincare",
    "minimalist",
    "the-ordinary",
    "gemini-ai",
    "routine-copilot",
    "nextjs",
    "express"
  ],
  "author": "Love & Co. Engineering Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
